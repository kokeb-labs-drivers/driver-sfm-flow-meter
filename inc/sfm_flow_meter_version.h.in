 *
 * Do not edit the generated file: the version is set once, in cmake/sfm_flow_meter_build_settings.cmake, and
 * configure_file() writes it here.
 */
#ifndef SFM_FLOW_METER_VERSION_H
#define SFM_FLOW_METER_VERSION_H

/** Major version: incompatible API changes. */
#define SFM_FLOW_METER_VERSION_MAJOR @SFM_FLOW_METER_VERSION_MAJOR@
/** Minor version: features added compatibly. */
#define SFM_FLOW_METER_VERSION_MINOR @SFM_FLOW_METER_VERSION_MINOR@
/** Patch version: fixes. */
#define SFM_FLOW_METER_VERSION_PATCH @SFM_FLOW_METER_VERSION_PATCH@
/** Full version string, for example "0.1.0". */
#define SFM_FLOW_METER_VERSION_STRING "@SFM_FLOW_METER_VERSION@"

#endif // SFM_FLOW_METER_VERSION_H
